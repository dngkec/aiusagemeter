<Application x:Class="AIUsageMeter.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AIUsageMeter.Windows"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <local:BooleanToVisibilityConverterEx x:Key="BooleanToVisibility" />
    <SolidColorBrush x:Key="PanelBrush" Color="#F21A1B20" />
    <SolidColorBrush x:Key="CardBrush" Color="#FF292A31" />
    <SolidColorBrush x:Key="MutedBrush" Color="#FF9C9DA5" />
  </Application.Resources>
</Application>
