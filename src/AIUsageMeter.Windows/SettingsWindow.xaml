<Window x:Class="AIUsageMeter.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AIUsageMeter Settings" Width="940" Height="720" MinWidth="820" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="#FF17181D" Foreground="White">
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TabControl Background="#FF202127" Foreground="White" BorderBrush="#FF3A3B43">
      <TabItem Header="General">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="22" MaxWidth="650" HorizontalAlignment="Left">
          <TextBlock Text="Overlay" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,18"/>
          <CheckBox Content="Show the right-edge overlay" IsChecked="{Binding OverlayVisible}" Margin="0,0,0,12"/>
          <CheckBox Content="Launch AIUsageMeter when I sign in" IsChecked="{Binding LaunchAtLogin}" Margin="0,0,0,12"/>
          <CheckBox Content="Use deterministic demo data" IsChecked="{Binding DemoData}" Margin="0,0,0,18"/>
          <TextBlock Text="Refresh interval"/><ComboBox ItemsSource="{Binding RefreshIntervals}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding RefreshIntervalSeconds}" Width="240" HorizontalAlignment="Left" Margin="0,5,0,14"/>
          <TextBlock Text="Display"/><ComboBox ItemsSource="{Binding Displays}" SelectedValuePath="Id" DisplayMemberPath="Name" SelectedValue="{Binding ScreenIdentifier}" Width="360" HorizontalAlignment="Left" Margin="0,5,0,14"/>
          <TextBlock Text="Vertical position"/><ComboBox ItemsSource="{Binding VerticalPositions}" SelectedItem="{Binding VerticalPosition}" Width="200" HorizontalAlignment="Left" Margin="0,5,0,14"/>
          <TextBlock Text="Fine offset (DIP)"/><Slider Minimum="-500" Maximum="500" Value="{Binding VerticalOffset}" Width="360" HorizontalAlignment="Left" TickFrequency="10"/>
          <TextBlock Text="Overlay size" Margin="0,14,0,0"/><ComboBox ItemsSource="{Binding OverlaySizes}" SelectedItem="{Binding OverlaySize}" Width="200" HorizontalAlignment="Left" Margin="0,5,0,14"/>
          <TextBlock Text="The overlay is always on top and reserves no taskbar space. ‘Display with pointer’ follows the pointer whenever display settings change."
                     Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="Providers">
        <Grid Margin="16"><Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <ListBox ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}" SelectionChanged="ProviderSelection_Changed" Background="#FF202127" BorderBrush="#FF3A3B43">
              <ListBox.ItemTemplate><DataTemplate><DockPanel Margin="5">
                <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding Name}" Foreground="White" VerticalAlignment="Center"/>
              </DockPanel></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0"><Button Content="Move up" Click="MoveUp_Click" Padding="10,5"/><Button Content="Move down" Click="MoveDown_Click" Padding="10,5" Margin="8,0,0,0"/></StackPanel>
          </Grid>
          <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel DataContext="{Binding SelectedProvider}" Margin="4" Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibility}}">
              <TextBlock Text="{Binding Name}" FontSize="22" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding Availability}" Foreground="#FFFFCC80" TextWrapping="Wrap" Margin="0,6,0,14"/>
              <CheckBox Content="Show in overlay" IsChecked="{Binding ShowInOverlay}" Margin="0,0,0,12"/>
              <TextBlock Text="Source"/><ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" Width="220" HorizontalAlignment="Left" Margin="0,5,0,12"/>
              <TextBlock Text="Monthly budget (USD)"/><TextBox Text="{Binding MonthlyBudget, UpdateSourceTrigger=PropertyChanged}" Width="220" HorizontalAlignment="Left" Margin="0,5,0,12"/>
              <TextBlock Text="Workspace / team ID"/><TextBox Text="{Binding WorkspaceId, UpdateSourceTrigger=PropertyChanged}" Width="360" HorizontalAlignment="Left" Margin="0,5,0,12"/>
              <TextBlock Text="Region"/><ComboBox ItemsSource="{Binding Regions}" SelectedItem="{Binding Region}" Width="220" HorizontalAlignment="Left" Margin="0,5,0,16"/>
              <Separator Margin="0,0,0,14"/>
              <TextBlock Text="App-owned secret" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding SecretStatus}" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,5"/>
              <PasswordBox x:Name="SecretBox" PasswordChanged="Secret_Changed" Width="360" HorizontalAlignment="Left" ToolTip="Leave blank to keep the saved secret"/>
              <CheckBox Content="Remove the saved secret" IsChecked="{Binding RemoveSecret}" Margin="0,7,0,16"/>
              <Separator Margin="0,0,0,14"/>
              <TextBlock Text="Manual budget" FontWeight="SemiBold"/>
              <WrapPanel Margin="0,5,0,8"><TextBox Text="{Binding ManualUsed}" Width="100"/><TextBlock Text=" used of " Margin="8,4"/><TextBox Text="{Binding ManualLimit}" Width="100"/></WrapPanel>
              <TextBlock Text="Reset date (optional)"/><DatePicker SelectedDate="{Binding ManualResetDate}" Width="180" HorizontalAlignment="Left" Margin="0,4,0,14"/>
              <TextBlock Text="Custom JSON connector" FontWeight="SemiBold"/>
              <TextBlock Text="Display name"/><TextBox Text="{Binding CustomName}" Margin="0,4,0,8"/>
              <TextBlock Text="Endpoint"/><TextBox Text="{Binding Endpoint}" Margin="0,4,0,8"/>
              <WrapPanel><ComboBox ItemsSource="{Binding HttpMethods}" SelectedItem="{Binding HttpMethod}" Width="100"/><ComboBox ItemsSource="{Binding SecretPlacements}" SelectedItem="{Binding SecretPlacement}" Width="180" Margin="8,0,0,0"/></WrapPanel>
              <TextBlock Text="API-key header name" Margin="0,8,0,4"/><TextBox Text="{Binding ApiKeyHeader}"/>
              <TextBlock Text="JSON paths: percent, used, limit, reset" Margin="0,8,0,4"/>
              <WrapPanel><TextBox Text="{Binding PercentPath}" Width="150"/><TextBox Text="{Binding UsedPath}" Width="150" Margin="6,0"/><TextBox Text="{Binding LimitPath}" Width="150"/><TextBox Text="{Binding ResetPath}" Width="150" Margin="6,0,0,0"/></WrapPanel>
              <TextBlock Text="Dashboard URL" Margin="0,8,0,4"/><TextBox Text="{Binding DashboardUrl}"/>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </TabItem>
      <TabItem Header="About &amp; Support">
        <StackPanel Margin="28" MaxWidth="640" HorizontalAlignment="Left">
          <TextBlock Text="AIUsageMeter for Windows" FontSize="26" FontWeight="SemiBold"/>
          <TextBlock Text="Native .NET 8 WPF companion for the Swift macOS application." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,18"/>
          <TextBlock Text="The app never imports browser cookies, never logs credentials or response bodies, and keeps app-owned secrets in Windows Credential Manager." TextWrapping="Wrap"/>
          <WrapPanel Margin="0,20,0,0"><Button Content="GitHub" Click="Repository_Click" Padding="16,7"/><Button Content="Report an issue" Click="Issues_Click" Padding="16,7" Margin="8,0"/><Button Content="Buy me a coffee" Click="Sponsor_Click" Padding="16,7"/></WrapPanel>
          <TextBlock Text="Interface design inspired by @hivinz_." Foreground="{StaticResource MutedBrush}" Margin="0,24,0,0"/>
        </StackPanel>
      </TabItem>
    </TabControl>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <TextBlock Text="{Binding ValidationMessage}" Foreground="#FFFF6B6B" VerticalAlignment="Center" Margin="0,0,14,0"/>
      <Button Content="Cancel" Click="Cancel_Click" MinWidth="90" Padding="12,7"/>
      <Button Content="Save" Click="Save_Click" MinWidth="90" Padding="12,7" Margin="8,0,0,0" IsDefault="True"/>
    </StackPanel>
  </Grid>
</Window>
