<Window x:Class="AIUsageMeter.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dgn="clr-namespace:AIUsageMeter.Windows.Design"
        xmlns:set="clr-namespace:AIUsageMeter.Windows.Settings"
        xmlns:local="clr-namespace:AIUsageMeter.Windows"
        xmlns:core="clr-namespace:AIUsageMeter.Core;assembly=AIUsageMeter.Core"
        Title="Settings" Width="940" Height="680" MinWidth="820" MinHeight="560"
        Icon="/AIUsageMeter;component/Assets/AppIcon.ico"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{x:Static dgn:Palette.Surface}"
        Foreground="{x:Static dgn:Palette.Primary}"
        FontFamily="{x:Static dgn:Typo.Family}"
        TextOptions.TextRenderingMode="Grayscale"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.InputBindings>
    <KeyBinding Key="F" Modifiers="Control" Command="ApplicationCommands.Find"/>
  </Window.InputBindings>
  <Window.CommandBindings>
    <CommandBinding Command="ApplicationCommands.Find" Executed="FocusSearch"/>
  </Window.CommandBindings>
  <Window.Resources>
    <local:BooleanToVisibilityConverterEx x:Key="BoolVis"/>
    <set:NullToVisibilityConverter x:Key="NullVis"/>
    <set:InvertBoolConverter x:Key="InvertBool"/>
    <set:SelectedFillConverter x:Key="SelectedFill"/>
    <set:NoticeBrushConverter x:Key="NoticeBrush"/>

    <!-- ================================ Type ================================ -->
    <Style x:Key="PaneTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{x:Static dgn:SettingsTypo.PaneTitleSize}"/>
      <Setter Property="FontWeight" Value="{x:Static dgn:SettingsTypo.PaneTitleWeight}"/>
    </Style>
    <!-- Prose: a provider's summary, a status message. Leading is set, or Inter at 13 packs a
         wrapped paragraph tight enough to read as a grey block. -->
    <Style x:Key="Body" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{x:Static dgn:SettingsTypo.BodySize}"/>
      <Setter Property="FontWeight" Value="{x:Static dgn:SettingsTypo.BodyWeight}"/>
      <Setter Property="Foreground" Value="{x:Static dgn:Palette.Secondary}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="LineHeight" Value="{x:Static dgn:SettingsMetrics.BodyLine}"/>
      <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    </Style>
    <Style x:Key="RowLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{x:Static dgn:SettingsTypo.RowLabelSize}"/>
      <Setter Property="FontWeight" Value="{x:Static dgn:SettingsTypo.RowLabelWeight}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <!-- Readouts that change in place. Proportional digits jerk sideways on every refresh. -->
    <Style x:Key="RowValue" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{x:Static dgn:SettingsTypo.MetaSize}"/>
      <Setter Property="FontWeight" Value="{x:Static dgn:SettingsTypo.MetaWeight}"/>
      <Setter Property="Foreground" Value="{x:Static dgn:Palette.Secondary}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>
    <!-- The header over a group of rows, and the note under it. Both are inset to the rows'
         own leading edge, so a pane reads as one column and not as three. -->
    <Style x:Key="Section" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{x:Static dgn:SettingsTypo.SectionSize}"/>
      <Setter Property="FontWeight" Value="{x:Static dgn:SettingsTypo.SectionWeight}"/>
      <Setter Property="Foreground" Value="{x:Static dgn:Palette.Primary}"/>
      <Setter Property="Margin" Value="{x:Static dgn:SettingsMetrics.Section}"/>
    </Style>
    <Style x:Key="Footnote" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{x:Static dgn:SettingsTypo.FooterSize}"/>
      <Setter Property="Foreground" Value="{x:Static dgn:Palette.Secondary}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="LineHeight" Value="{x:Static dgn:SettingsMetrics.FootnoteLine}"/>
      <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
      <Setter Property="Margin" Value="{x:Static dgn:SettingsMetrics.Footnote}"/>
    </Style>
    <Style x:Key="SidebarRow" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{x:Static dgn:SettingsTypo.SidebarSize}"/>
      <Setter Property="FontWeight" Value="{x:Static dgn:SettingsTypo.SidebarWeight}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- ============================== Grouped list ============================== -->
    <!-- A card carries no padding of its own: every row states the same inset, so a row that
         wraps and a row that does not still line up on one leading edge. -->
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{x:Static dgn:Palette.GroupFill}"/>
      <Setter Property="BorderBrush" Value="{x:Static dgn:Palette.Divider}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="{x:Static dgn:SettingsMetrics.Card}"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    <!-- One row. Every control in it sits on the trailing edge and every row is the same height,
         whether it holds a switch, a field or a stepper. -->
    <Style x:Key="Row" TargetType="DockPanel">
      <Setter Property="LastChildFill" Value="False"/>
      <Setter Property="MinHeight" Value="{x:Static dgn:SettingsMetrics.RowHeight}"/>
      <Setter Property="Margin" Value="{x:Static dgn:SettingsMetrics.Row}"/>
    </Style>
    <!-- A row whose field takes the width left over: URLs and JSON paths, which a 260 field
         would truncate mid-word. The label sits in a column shared across the card, so those
         fields start on one edge instead of each beginning wherever its own label ended. -->
    <Style x:Key="WideRow" TargetType="Grid">
      <Setter Property="MinHeight" Value="{x:Static dgn:SettingsMetrics.RowHeight}"/>
      <Setter Property="Margin" Value="{x:Static dgn:SettingsMetrics.Row}"/>
    </Style>
    <!-- The label column of a wide row. Auto, so the widest label in the card sets it. -->
    <Style x:Key="WideRowLabel" TargetType="ColumnDefinition">
      <Setter Property="Width" Value="Auto"/>
      <Setter Property="SharedSizeGroup" Value="RowLabel"/>
    </Style>
    <!-- A row that wraps, so it grows downwards rather than centring in one row's height. -->
    <Style x:Key="StackedRow" TargetType="StackPanel">
      <Setter Property="Margin" Value="{x:Static dgn:SettingsMetrics.RowStacked}"/>
    </Style>
    <Style x:Key="Separator" TargetType="Rectangle">
      <Setter Property="Height" Value="1"/>
      <Setter Property="Fill" Value="{x:Static dgn:Palette.Divider}"/>
      <Setter Property="Margin" Value="{x:Static dgn:SettingsMetrics.Separator}"/>
    </Style>

    <!-- ================================ Fields ================================ -->
    <!--
      The keyboard ring is a second border outside the field, on a negative margin. Thickening the
      field's own border instead would shrink its content box and shove the text by a pixel every
      time it took focus. The selection brush is set for the same reason the template exists: left
      alone, WPF paints a Windows-blue focus rectangle and a Windows-blue selection over a window
      that has no blue in it anywhere.
    -->
    <ControlTemplate x:Key="FieldShell" TargetType="Control">
      <Grid>
        <Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="1" CornerRadius="{x:Static dgn:SettingsMetrics.Field}"
                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
          <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False"/>
        </Border>
        <Border x:Name="Ring" Margin="{x:Static dgn:SettingsMetrics.Ring}" BorderThickness="2"
                BorderBrush="Transparent" CornerRadius="{x:Static dgn:SettingsMetrics.FieldRing}"
                IsHitTestVisible="False"/>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter TargetName="Shell" Property="BorderBrush" Value="{x:Static dgn:Palette.Dormant}"/>
        </Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True">
          <Setter TargetName="Shell" Property="BorderBrush" Value="{x:Static dgn:Palette.Dormant}"/>
          <Setter TargetName="Ring" Property="BorderBrush" Value="{x:Static dgn:Palette.FocusRing}"/>
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.4"/>
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{x:Static dgn:Palette.Inset}"/>
      <Setter Property="Foreground" Value="{x:Static dgn:Palette.Primary}"/>
      <Setter Property="BorderBrush" Value="{x:Static dgn:Palette.Divider}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CaretBrush" Value="{x:Static dgn:Palette.Primary}"/>
      <Setter Property="SelectionBrush" Value="{x:Static dgn:Palette.FocusRing}"/>
      <Setter Property="Padding" Value="9,0"/>
      <Setter Property="Height" Value="{x:Static dgn:SettingsMetrics.FieldHeight}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="{x:Static dgn:SettingsTypo.BodySize}"/>
      <Setter Property="Template" Value="{StaticResource FieldShell}"/>
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Background" Value="{x:Static dgn:Palette.Inset}"/>
      <Setter Property="Foreground" Value="{x:Static dgn:Palette.Primary}"/>
      <Setter Property="BorderBrush" Value="{x:Static dgn:Palette.Divider}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CaretBrush" Value="{x:Static dgn:Palette.Primary}"/>
      <Setter Property="SelectionBrush" Value="{x:Static dgn:Palette.FocusRing}"/>
      <Setter Property="Padding" Value="9,0"/>
      <Setter Property="Height" Value="{x:Static dgn:SettingsMetrics.FieldHeight}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="{x:Static dgn:SettingsTypo.BodySize}"/>
      <Setter Property="Template" Value="{StaticResource FieldShell}"/>
    </Style>
    <!-- Every short field is one width, so a card's fields share a leading and a trailing edge
         rather than each starting wherever its own label happened to end. -->
    <Style x:Key="Field" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Width" Value="{x:Static dgn:SettingsMetrics.FieldWidth}"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>
    <Style x:Key="SecretField" TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
      <Setter Property="Width" Value="{x:Static dgn:SettingsMetrics.FieldWidth}"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>
    <Style x:Key="WideField" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="MinWidth" Value="{x:Static dgn:SettingsMetrics.FieldWidth}"/>
      <Setter Property="Margin" Value="16,0,0,0"/>
    </Style>

    <!-- ================================ Buttons ================================ -->
    <Style x:Key="QuietButton" TargetType="Button">
      <Setter Property="Foreground" Value="{x:Static dgn:Palette.Primary}"/>
      <Setter Property="FontSize" Value="{x:Static dgn:SettingsTypo.RowLabelSize}"/>
      <Setter Property="FontWeight" Value="{x:Static dgn:SettingsTypo.RowLabelWeight}"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="MinHeight" Value="{x:Static dgn:SettingsMetrics.FieldHeight}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="Bd" Background="{x:Static dgn:Palette.ActiveFill}" CornerRadius="{x:Static dgn:SettingsMetrics.Field}"
                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border x:Name="Ring" Margin="{x:Static dgn:SettingsMetrics.Ring}" BorderThickness="2"
                    BorderBrush="Transparent" CornerRadius="{x:Static dgn:SettingsMetrics.FieldRing}"
                    IsHitTestVisible="False"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{x:Static dgn:Palette.HoverFill}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{x:Static dgn:Palette.PressFill}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Ring" Property="BorderBrush" Value="{x:Static dgn:Palette.FocusRing}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.35"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- The one default action on a pane, and the only white fill in the window. -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
      <Setter Property="Foreground" Value="{x:Static dgn:Palette.Surface}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="Bd" Background="{x:Static dgn:Palette.Primary}" CornerRadius="{x:Static dgn:SettingsMetrics.Field}"
                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border x:Name="Ring" Margin="{x:Static dgn:SettingsMetrics.Ring}" BorderThickness="2"
                    BorderBrush="Transparent" CornerRadius="{x:Static dgn:SettingsMetrics.FieldRing}"
                    IsHitTestVisible="False"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{x:Static dgn:Palette.PrimaryMuted}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Ring" Property="BorderBrush" Value="{x:Static dgn:Palette.FocusRing}"/>
            </Trigger>
            <!-- A disabled default action drops the fill entirely rather than dimming a white
                 slab, which stays the loudest thing on the pane even at a third of its opacity. -->
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Background" Value="{x:Static dgn:Palette.ActiveFill}"/>
              <Setter Property="Foreground" Value="{x:Static dgn:Palette.Tertiary}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="GoldButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="Template">
        <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{x:Static dgn:Palette.Sponsor}" CornerRadius="{x:Static dgn:SettingsMetrics.Field}"
                  Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- A credit or a repository is a link, not a control. It reads as text and underlines under
         the pointer, rather than sitting in the pane as one more grey pill. -->
    <Style x:Key="LinkButton" TargetType="Button">
      <Setter Property="Foreground" Value="{x:Static dgn:Palette.Primary}"/>
      <Setter Property="FontSize" Value="{x:Static dgn:SettingsTypo.BodySize}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
        <ControlTemplate TargetType="Button">
          <TextBlock x:Name="Ink" Text="{TemplateBinding Content}" Background="Transparent"
                     Foreground="{TemplateBinding Foreground}" TextTrimming="CharacterEllipsis"/>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Ink" Property="TextDecorations" Value="Underline"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Ink" Property="TextDecorations" Value="Underline"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="NavButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{x:Static dgn:Palette.Primary}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="FontSize" Value="{x:Static dgn:SettingsTypo.SidebarSize}"/>
      <Setter Property="FontWeight" Value="{x:Static dgn:SettingsTypo.SidebarWeight}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{x:Static dgn:Palette.GroupFill}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Half a stepper. The chip is inset from the shell rather than filling it: a Border does not
         clip its child to its own corner radius, so a full-bleed hover would square off the ends. -->
    <Style x:Key="StepButton" TargetType="Button">
      <Setter Property="Width" Value="30"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Margin="2" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{x:Static dgn:Palette.HoverFill}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{x:Static dgn:Palette.PressFill}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{x:Static dgn:Palette.ActiveFill}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.3"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ================================ Slider ================================ -->
    <Style TargetType="Slider">
      <Setter Property="Foreground" Value="{x:Static dgn:Palette.Primary}"/>
      <Setter Property="Height" Value="20"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid VerticalAlignment="Center">
              <Border Height="4" CornerRadius="2" Background="{x:Static dgn:Palette.BarTrack}" VerticalAlignment="Center"/>
              <Track x:Name="PART_Track">
                <!-- The travelled part of the track is drawn by the decrease button, which would
                     otherwise be an invisible click target and nothing else. -->
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent">
                          <Border Height="4" CornerRadius="2" Background="{x:Static dgn:Palette.Primary}" VerticalAlignment="Center"/>
                        </Grid>
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="Slider.IncreaseLarge" Opacity="0" Focusable="False"/>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Width="16" Height="16" Cursor="Hand">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Grid>
                          <Ellipse x:Name="Knob" Fill="White"/>
                          <Ellipse x:Name="Ring" Margin="-3" Stroke="Transparent" StrokeThickness="2"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{x:Static dgn:Palette.FocusRing}"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============================== Scroll bars ============================== -->
    <!--
      WPF still ships the Windows 7 scrollbar: a #F0F0F0 track, a #CDCDCD thumb and a pair of arrow
      buttons, none of which follow dark mode or the Windows 11 bar. .NET 8 has no Fluent theme to
      opt into, so the bar is drawn here in the app's own palette instead. Window-level, so the
      panes, the provider sidebar and the picker's popup list all take it.
    -->
    <Style x:Key="ScrollPage" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <!-- Invisible, but still hit-tested, so clicking the track pages as it should. -->
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ScrollThumb" TargetType="Thumb">
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <!-- The padded outer border keeps the grab target the full width of the bar while the
                 visible thumb stays thin. -->
            <Border Background="Transparent" Padding="2">
              <Border x:Name="Fill" Background="{x:Static dgn:Palette.Dormant}" CornerRadius="3"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Fill" Property="Background" Value="{x:Static dgn:Palette.FocusRing}"/>
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="Fill" Property="Background" Value="{x:Static dgn:Palette.Secondary}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <ControlTemplate x:Key="VerticalScrollBar" TargetType="ScrollBar">
      <Border Background="{TemplateBinding Background}">
        <Track x:Name="PART_Track" IsDirectionReversed="True">
          <Track.DecreaseRepeatButton>
            <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand"/>
          </Track.DecreaseRepeatButton>
          <Track.Thumb>
            <Thumb Style="{StaticResource ScrollThumb}"/>
          </Track.Thumb>
          <Track.IncreaseRepeatButton>
            <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand"/>
          </Track.IncreaseRepeatButton>
        </Track>
      </Border>
    </ControlTemplate>
    <ControlTemplate x:Key="HorizontalScrollBar" TargetType="ScrollBar">
      <Border Background="{TemplateBinding Background}">
        <Track x:Name="PART_Track">
          <Track.DecreaseRepeatButton>
            <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageLeftCommand"/>
          </Track.DecreaseRepeatButton>
          <Track.Thumb>
            <Thumb Style="{StaticResource ScrollThumb}"/>
          </Track.Thumb>
          <Track.IncreaseRepeatButton>
            <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageRightCommand"/>
          </Track.IncreaseRepeatButton>
        </Track>
      </Border>
    </ControlTemplate>
    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Width" Value="10"/>
      <Setter Property="MinWidth" Value="10"/>
      <Setter Property="Template" Value="{StaticResource VerticalScrollBar}"/>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/>
          <Setter Property="MinWidth" Value="0"/>
          <Setter Property="Height" Value="10"/>
          <Setter Property="MinHeight" Value="10"/>
          <Setter Property="Template" Value="{StaticResource HorizontalScrollBar}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="250" MinWidth="232" MaxWidth="320"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" BorderBrush="{x:Static dgn:Palette.Edge}" BorderThickness="0,0,1,0"
            PreviewKeyDown="Sidebar_PreviewKeyDown">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Margin="10,12,10,8">
          <TextBox x:Name="SearchBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                   KeyDown="Search_KeyDown" FontSize="{x:Static dgn:SettingsTypo.SearchSize}"
                   AutomationProperties.Name="Search providers"/>
          <TextBlock Text="Search providers" IsHitTestVisible="False" VerticalAlignment="Center" Margin="11,0"
                     Foreground="{x:Static dgn:Palette.Tertiary}" FontSize="{x:Static dgn:SettingsTypo.SearchSize}"
                     Visibility="{Binding ShowSearchPlaceholder, Converter={StaticResource BoolVis}}"/>
        </Grid>
        <ListBox x:Name="ProviderList" Grid.Row="1" ItemsSource="{Binding FilteredProviders}"
                 SelectedItem="{Binding SelectedProvider}"
                 Background="Transparent" BorderThickness="0" Padding="6,0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 AllowDrop="True" PreviewMouseLeftButtonDown="ProviderList_PreviewMouseLeftButtonDown"
                 MouseMove="ProviderList_MouseMove" Drop="ProviderList_Drop"
                 SelectionChanged="ProviderSelection_Changed">
          <ListBox.Template>
            <ControlTemplate TargetType="ListBox">
              <!--
                CanContentScroll is inherited, and ListBox's own theme style turns it on, so without
                this the StackPanel below becomes the scroll host and scrolls a whole child at a
                time: one notch for General, one for About, one for the section label, then one that
                steps over all 27 providers at once and leaves the sidebar blank. Pixels, not items.
              -->
              <ScrollViewer CanContentScroll="False" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                  <Button Style="{StaticResource NavButton}" Click="General_Click" Margin="0,0,0,2"
                          Background="{Binding IsGeneralPane, Converter={StaticResource SelectedFill}}">
                    <TextBlock Text="General"/>
                  </Button>
                  <Button Style="{StaticResource NavButton}" Click="About_Click" Margin="0,0,0,8"
                          Background="{Binding IsAboutPane, Converter={StaticResource SelectedFill}}">
                    <TextBlock Text="About &amp; Support"/>
                  </Button>
                  <TextBlock Text="PROVIDERS" FontSize="{x:Static dgn:SettingsTypo.SidebarSectionSize}"
                             FontWeight="{x:Static dgn:SettingsTypo.SidebarSectionWeight}"
                             Foreground="{x:Static dgn:Palette.Tertiary}" Margin="10,6,10,6"/>
                  <ItemsPresenter/>
                  <TextBlock Text="{Binding FilterEmptyMessage}" Style="{StaticResource Footnote}"
                             Margin="10,8,10,16"
                             Visibility="{Binding FilterEmpty, Converter={StaticResource BoolVis}}"/>
                </StackPanel>
              </ScrollViewer>
            </ControlTemplate>
          </ListBox.Template>
          <!-- The rows sit inside a StackPanel, which measures them at infinite height, so a
               virtualising panel could never drop one anyway. Plain, so it does not try. -->
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel/>
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <!-- Control re-registers Foreground with its own default of black, so a ListBoxItem
                   never inherits the window's white and every unstyled run of text in the row is
                   drawn black on black. The row label is the one piece with no brush of its own. -->
              <Setter Property="Foreground" Value="{x:Static dgn:Palette.Primary}"/>
              <Setter Property="Padding" Value="0"/>
              <Setter Property="Margin" Value="0,1"/>
              <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
              <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}"/>
              <Setter Property="Template">
                <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="Bd" CornerRadius="7" Padding="10,6" Background="Transparent">
                    <ContentPresenter/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="Bd" Property="Background" Value="{x:Static dgn:Palette.ActiveFill}"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Bd" Property="Background" Value="{x:Static dgn:Palette.GroupFill}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid x:Name="Row">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <set:SettingsGauge Percent="{Binding Percent}" Status="{Binding GaugeStatus}"
                                   Provider="{Binding Id}" Extent="18" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Style="{StaticResource SidebarRow}" Text="{Binding Name}" Margin="8,0"/>
                <TextBlock Grid.Column="2" Style="{StaticResource RowValue}" Text="{Binding Badge}"/>
              </Grid>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsDimmed}" Value="True">
                  <Setter TargetName="Row" Property="Opacity" Value="0.45"/>
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Border Grid.Row="2" BorderBrush="{x:Static dgn:Palette.Divider}" BorderThickness="0,1,0,0" Padding="12,10">
          <TextBlock Text="{Binding SidebarHint}" FontSize="11" Foreground="{x:Static dgn:Palette.Tertiary}" TextTrimming="CharacterEllipsis"/>
        </Border>
      </Grid>
    </Border>

    <!--
      The detail pane. One reading column, centred: pinned to the leading edge at a fixed width it
      left a third of a wide window empty and every row's control stranded mid-pane.
    -->
    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False">
      <StackPanel MaxWidth="{x:Static dgn:SettingsMetrics.ColumnWidth}" HorizontalAlignment="Center"
                  Margin="{x:Static dgn:SettingsMetrics.Pane}">
        <Border Style="{StaticResource Card}" Margin="0,0,0,20"
                Visibility="{Binding Notice, Converter={StaticResource NullVis}}">
          <!-- A notice can run to two or three lines, so the row grows rather than centring in
               one row's height, and carries its own air top and bottom. -->
          <DockPanel Style="{StaticResource Row}" LastChildFill="True"
                     Margin="{x:Static dgn:SettingsMetrics.RowStacked}">
            <Button Style="{StaticResource QuietButton}" Content="Dismiss" Click="DismissNotice_Click"
                    DockPanel.Dock="Right" Margin="12,0,0,0"/>
            <TextBlock Text="{Binding Notice.Text}" Style="{StaticResource Body}" VerticalAlignment="Center"
                       Foreground="{Binding Notice.IsFailure, Converter={StaticResource NoticeBrush}}"/>
          </DockPanel>
        </Border>

        <!-- ================================ General ================================ -->
        <StackPanel Visibility="{Binding IsGeneralPane, Converter={StaticResource BoolVis}}">
          <StackPanel Margin="{x:Static dgn:SettingsMetrics.Row}">
            <TextBlock Style="{StaticResource PaneTitle}" Text="General"/>
            <TextBlock Style="{StaticResource Body}" Margin="0,6,0,0"
                       Text="How the overlay looks, where it sits, and how often it reads."/>
          </StackPanel>

          <TextBlock Style="{StaticResource Section}" Text="Appearance"/>
          <Border Style="{StaticResource Card}">
            <DockPanel Style="{StaticResource Row}">
              <TextBlock Style="{StaticResource RowLabel}" Text="Overlay size"/>
              <set:SettingsSegmented DockPanel.Dock="Right" VerticalAlignment="Center"
                                     ItemsSource="{Binding OverlaySizes}" SelectedValue="{Binding OverlaySize}"/>
            </DockPanel>
          </Border>
          <TextBlock Style="{StaticResource Footnote}" Text="The size applies to the rail, its gauges, and the detail card together."/>

          <TextBlock Style="{StaticResource Section}" Text="Placement"/>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <DockPanel Style="{StaticResource Row}">
                <TextBlock Style="{StaticResource RowLabel}" Text="Display"/>
                <set:SettingsPicker DockPanel.Dock="Right" VerticalAlignment="Center" MaxWidth="300"
                                    ItemsSource="{Binding Displays}" SelectedValue="{Binding ScreenIdentifier}"/>
              </DockPanel>
              <Rectangle Style="{StaticResource Separator}"/>
              <DockPanel Style="{StaticResource Row}">
                <TextBlock Style="{StaticResource RowLabel}" Text="Vertical position"/>
                <set:SettingsSegmented DockPanel.Dock="Right" VerticalAlignment="Center"
                                       ItemsSource="{Binding VerticalPositions}" SelectedValue="{Binding VerticalPosition}"/>
              </DockPanel>
              <Rectangle Style="{StaticResource Separator}"/>
              <DockPanel Style="{StaticResource Row}" LastChildFill="True">
                <TextBlock Style="{StaticResource RowLabel}" Text="Fine adjustment" DockPanel.Dock="Left"/>
                <Button Style="{StaticResource QuietButton}" Content="Reset" Click="ResetOffset_Click" DockPanel.Dock="Right"
                        IsEnabled="{Binding OffsetIsNonZero}" Margin="12,0,0,0"/>
                <TextBlock Style="{StaticResource RowValue}" Text="{Binding VerticalOffset, StringFormat={}{0:0} DIP}"
                           Width="64" TextAlignment="Right" DockPanel.Dock="Right"/>
                <Slider Minimum="{x:Static core:OverlayOffset.Min}" Maximum="{x:Static core:OverlayOffset.Max}"
                        Value="{Binding VerticalOffset}" VerticalAlignment="Center" Margin="20,0,16,0" MinWidth="120"
                        AutomationProperties.Name="Fine adjustment"/>
              </DockPanel>
            </StackPanel>
          </Border>
          <TextBlock Style="{StaticResource Footnote}" Text="Fine adjustment nudges the overlay away from the position above, in DIP."/>

          <TextBlock Style="{StaticResource Section}" Text="Updating"/>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <DockPanel Style="{StaticResource Row}">
                <TextBlock Style="{StaticResource RowLabel}" Text="Refresh every"/>
                <set:SettingsPicker DockPanel.Dock="Right" VerticalAlignment="Center"
                                    ItemsSource="{Binding RefreshIntervals}" SelectedValue="{Binding RefreshIntervalSeconds}"/>
              </DockPanel>
              <Rectangle Style="{StaticResource Separator}"/>
              <DockPanel Style="{StaticResource Row}">
                <TextBlock Style="{StaticResource RowValue}" Text="{Binding RefreshCaption}"/>
                <Button Style="{StaticResource QuietButton}" Content="Refresh now" Click="RefreshNow_Click" DockPanel.Dock="Right"
                        IsEnabled="{Binding IsRefreshing, Converter={StaticResource InvertBool}}"/>
              </DockPanel>
            </StackPanel>
          </Border>

          <TextBlock Style="{StaticResource Section}" Text="Behaviour"/>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <DockPanel Style="{StaticResource Row}">
                <TextBlock Style="{StaticResource RowLabel}" Text="Show the overlay"/>
                <set:SettingsToggle DockPanel.Dock="Right" VerticalAlignment="Center"
                                    IsChecked="{Binding OverlayVisible}" AutomationProperties.Name="Show the overlay"/>
              </DockPanel>
              <Rectangle Style="{StaticResource Separator}"/>
              <DockPanel Style="{StaticResource Row}">
                <TextBlock Style="{StaticResource RowLabel}" Text="Launch at sign-in"/>
                <set:SettingsToggle DockPanel.Dock="Right" VerticalAlignment="Center"
                                    IsChecked="{Binding LaunchAtLogin}" AutomationProperties.Name="Launch at sign-in"/>
              </DockPanel>
              <Rectangle Style="{StaticResource Separator}"/>
              <DockPanel Style="{StaticResource Row}">
                <TextBlock Style="{StaticResource RowLabel}" Text="Use demo data"/>
                <set:SettingsToggle DockPanel.Dock="Right" VerticalAlignment="Center"
                                    IsChecked="{Binding DemoData}" AutomationProperties.Name="Use demo data"/>
              </DockPanel>
            </StackPanel>
          </Border>
          <TextBlock Style="{StaticResource Footnote}" Text="Demo data is deterministic, clearly labelled, and never replaces a failed live reading. Secrets live in Credential Manager. Settings apply as you make them."/>
        </StackPanel>

        <!-- ================================= About ================================= -->
        <StackPanel Visibility="{Binding IsAboutPane, Converter={StaticResource BoolVis}}">
          <DockPanel Margin="{x:Static dgn:SettingsMetrics.Row}" LastChildFill="True">
            <Border Width="64" Height="64" CornerRadius="14" Background="{x:Static dgn:Palette.GroupFill}"
                    BorderBrush="{x:Static dgn:Palette.Edge}" BorderThickness="1" DockPanel.Dock="Left" Margin="0,0,16,0">
              <Image Source="/AIUsageMeter;component/Assets/AppIcon.png" Width="56" Height="56" Stretch="Uniform"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Style="{StaticResource PaneTitle}" Text="AIUsageMeter"/>
              <TextBlock Text="{Binding VersionSummary}" Style="{StaticResource Body}" Margin="0,4,0,0"/>
              <TextBlock Style="{StaticResource Body}" Margin="0,6,0,0"
                         Text="A native Windows usage monitor for the AI coding plans you already pay for."/>
            </StackPanel>
          </DockPanel>

          <TextBlock Style="{StaticResource Section}" Text="Updates"/>
          <Border Style="{StaticResource Card}">
            <StackPanel Style="{StaticResource StackedRow}">
              <TextBlock Style="{StaticResource Body}" Margin="0,0,0,14" TextWrapping="Wrap"
                         Text="AIUsageMeter looks for a new release on launch and once a day after that. Nothing is downloaded until you ask for it, and every download is checked against the checksum published with the release before it runs."/>
              <TextBlock Text="{Binding UpdateSummary}" Style="{StaticResource Body}" Margin="0,0,0,14" TextWrapping="Wrap"
                         Foreground="{Binding UpdateIsFailure, Converter={StaticResource NoticeBrush}}"
                         Visibility="{Binding HasUpdateSummary, Converter={StaticResource BoolVis}}"/>
              <WrapPanel>
                <Button Style="{StaticResource PrimaryButton}" Content="{Binding InstallUpdateLabel}" Click="InstallUpdate_Click"
                        Margin="0,0,8,0" Visibility="{Binding CanInstallUpdate, Converter={StaticResource BoolVis}}"/>
                <Button Style="{StaticResource QuietButton}" Content="Check now" Click="CheckForUpdates_Click"
                        Margin="0,0,8,0" IsEnabled="{Binding CanCheckForUpdates}"/>
                <Button Style="{StaticResource QuietButton}" Content="Release notes" Click="ReleaseNotes_Click"
                        Visibility="{Binding HasReleaseNotes, Converter={StaticResource BoolVis}}"/>
              </WrapPanel>
            </StackPanel>
          </Border>

          <TextBlock Style="{StaticResource Section}" Text="Support"/>
          <Border Style="{StaticResource Card}">
            <StackPanel Style="{StaticResource StackedRow}">
              <TextBlock Style="{StaticResource Body}" Margin="0,0,0,14"
                         Text="AIUsageMeter is free and open source. A coffee keeps it going."/>
              <WrapPanel>
                <Button Style="{StaticResource GoldButton}" Content="Buy me a coffee" Click="Sponsor_Click" Margin="0,0,8,0"/>
                <Button Style="{StaticResource QuietButton}" Content="GitHub" Click="Repository_Click" Margin="0,0,8,0"/>
                <Button Style="{StaticResource QuietButton}" Content="Report an issue" Click="Issues_Click"/>
              </WrapPanel>
            </StackPanel>
          </Border>

          <TextBlock Style="{StaticResource Section}" Text="Credits"/>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <DockPanel Style="{StaticResource Row}">
                <TextBlock Style="{StaticResource RowLabel}" Text="Design inspired by"/>
                <Button DockPanel.Dock="Right" Content="@hivinz_" Click="Designer_Click" Style="{StaticResource LinkButton}"/>
              </DockPanel>
              <Rectangle Style="{StaticResource Separator}"/>
              <DockPanel Style="{StaticResource Row}">
                <TextBlock Style="{StaticResource RowLabel}" Text="Source"/>
                <Button DockPanel.Dock="Right" Content="github.com/dngkec/aiusagemeter" Click="Repository_Click" Style="{StaticResource LinkButton}"/>
              </DockPanel>
              <Rectangle Style="{StaticResource Separator}"/>
              <DockPanel Style="{StaticResource Row}">
                <TextBlock Style="{StaticResource RowLabel}" Text="Licence"/>
                <TextBlock DockPanel.Dock="Right" Text="MIT" Style="{StaticResource Body}" VerticalAlignment="Center"/>
              </DockPanel>
            </StackPanel>
          </Border>
          <TextBlock Style="{StaticResource Footnote}" Text="The notch, the gauges, and the detail card are modelled on work by @hivinz_. Thank you."/>
        </StackPanel>

        <!-- ================================ Provider ================================
             The visibility and the data context must not sit on one element: a binding on the
             element that sets DataContext resolves against the new context, so asking a
             ProviderSettingsItem for IsProviderPane failed and left the pane permanently open. -->
        <StackPanel Visibility="{Binding IsProviderPane, Converter={StaticResource BoolVis}}">
         <StackPanel DataContext="{Binding SelectedProvider}">
          <DockPanel Margin="{x:Static dgn:SettingsMetrics.Row}" LastChildFill="True">
            <set:SettingsGauge Percent="{Binding Percent}" Status="{Binding GaugeStatus}" Provider="{Binding Id}"
                               Extent="{x:Static dgn:SettingsMetrics.HeaderGauge}" DockPanel.Dock="Left"
                               VerticalAlignment="Top" Margin="0,2,16,0"/>
            <StackPanel>
              <TextBlock Style="{StaticResource PaneTitle}" Text="{Binding Name}"/>
              <TextBlock Text="{Binding SupportCopy}" Style="{StaticResource Body}" Margin="0,6,0,0"/>
            </StackPanel>
          </DockPanel>

          <Border Style="{StaticResource Card}" Margin="0,20,0,0"
                  Visibility="{Binding ShowStatus, Converter={StaticResource BoolVis}}">
            <StackPanel Style="{StaticResource StackedRow}">
              <TextBlock Text="{Binding StatusLabel}" FontWeight="{x:Static dgn:SettingsTypo.SectionWeight}"
                         FontSize="{x:Static dgn:SettingsTypo.BodySize}" Foreground="{x:Static dgn:Palette.Primary}"/>
              <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Body}" Margin="0,2,0,0"
                         Visibility="{Binding StatusMessage, Converter={StaticResource NullVis}}"/>
            </StackPanel>
          </Border>

          <TextBlock Style="{StaticResource Section}" Text="Rail"/>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <DockPanel Style="{StaticResource Row}">
                <TextBlock Style="{StaticResource RowLabel}" Text="Enable this provider"/>
                <set:SettingsToggle DockPanel.Dock="Right" VerticalAlignment="Center"
                                    IsChecked="{Binding Enabled}" AutomationProperties.Name="Enable this provider"/>
              </DockPanel>
              <Rectangle Style="{StaticResource Separator}"/>
              <DockPanel Style="{StaticResource Row}">
                <TextBlock Style="{StaticResource RowLabel}" Text="Show in the overlay"/>
                <set:SettingsToggle DockPanel.Dock="Right" VerticalAlignment="Center"
                                    IsChecked="{Binding ShowInOverlay}" IsEnabled="{Binding ShowInOverlayEnabled}"
                                    AutomationProperties.Name="Show in the overlay"/>
              </DockPanel>
              <Rectangle Style="{StaticResource Separator}"/>
              <DockPanel Style="{StaticResource Row}">
                <TextBlock Style="{StaticResource RowLabel}" Text="Position in the rail"/>
                <!-- One stepper, not two buttons: the halves share a shell and a hairline, so the
                     pair reads as a single control the way a macOS stepper does. -->
                <Border DockPanel.Dock="Right" VerticalAlignment="Center"
                        Height="{x:Static dgn:SettingsMetrics.FieldHeight}"
                        Background="{x:Static dgn:Palette.Inset}" BorderBrush="{x:Static dgn:Palette.Divider}"
                        BorderThickness="1" CornerRadius="{x:Static dgn:SettingsMetrics.Field}" SnapsToDevicePixels="True">
                  <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource StepButton}" Click="MoveUp_Click" IsEnabled="{Binding CanMoveUp}"
                            ToolTip="Move up" AutomationProperties.Name="Move up">
                      <Path Data="M0,4.5 L5,0 L10,4.5" Stroke="{x:Static dgn:Palette.Primary}" StrokeThickness="1.6"
                            StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Button>
                    <Rectangle Width="1" Fill="{x:Static dgn:Palette.Divider}" Margin="0,5"/>
                    <Button Style="{StaticResource StepButton}" Click="MoveDown_Click" IsEnabled="{Binding CanMoveDown}"
                            ToolTip="Move down" AutomationProperties.Name="Move down">
                      <Path Data="M0,0 L5,4.5 L10,0" Stroke="{x:Static dgn:Palette.Primary}" StrokeThickness="1.6"
                            StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Button>
                  </StackPanel>
                </Border>
                <TextBlock Style="{StaticResource RowValue}" Text="{Binding RailPosition}" DockPanel.Dock="Right" Margin="0,0,12,0"/>
              </DockPanel>
            </StackPanel>
          </Border>
          <TextBlock Style="{StaticResource Footnote}" Text="A provider appears in the rail only while it is enabled and shown. Changes apply as you make them."/>

          <!-- The source and its own settings are one group: the fields below the picker are the
               picker's consequences, not a separate subject. -->
          <TextBlock Style="{StaticResource Section}" Text="Usage source"/>
          <Border Style="{StaticResource Card}">
            <StackPanel Grid.IsSharedSizeScope="True">
              <DockPanel Style="{StaticResource Row}">
                <TextBlock Style="{StaticResource RowLabel}" Text="Read usage from"/>
                <set:SettingsSegmented DockPanel.Dock="Right" VerticalAlignment="Center"
                                       ItemsSource="{Binding ModeOptions}" SelectedValue="{Binding Mode}"/>
              </DockPanel>

              <StackPanel Visibility="{Binding ShowLiveSection, Converter={StaticResource BoolVis}}">
                <!-- Each field keeps the hairline above it, so a mode that shows none of them
                     leaves no rule hanging under the picker. -->
                <StackPanel Visibility="{Binding ShowBudget, Converter={StaticResource BoolVis}}">
                  <Rectangle Style="{StaticResource Separator}"/>
                  <DockPanel Style="{StaticResource Row}">
                    <TextBlock Style="{StaticResource RowLabel}" Text="Monthly budget (USD)"/>
                    <TextBox DockPanel.Dock="Right" Style="{StaticResource Field}" AutomationProperties.Name="Monthly budget in US dollars"
                             Text="{Binding MonthlyBudget, UpdateSourceTrigger=PropertyChanged}"/>
                  </DockPanel>
                </StackPanel>
                <StackPanel Visibility="{Binding ShowWorkspace, Converter={StaticResource BoolVis}}">
                  <Rectangle Style="{StaticResource Separator}"/>
                  <DockPanel Style="{StaticResource Row}">
                    <TextBlock Style="{StaticResource RowLabel}" Text="{Binding WorkspacePrompt}"/>
                    <TextBox DockPanel.Dock="Right" Style="{StaticResource Field}" AutomationProperties.Name="{Binding WorkspacePrompt}"
                             Text="{Binding WorkspaceId, UpdateSourceTrigger=PropertyChanged}"/>
                  </DockPanel>
                </StackPanel>
                <StackPanel Visibility="{Binding ShowRegion, Converter={StaticResource BoolVis}}">
                  <Rectangle Style="{StaticResource Separator}"/>
                  <DockPanel Style="{StaticResource Row}">
                    <TextBlock Style="{StaticResource RowLabel}" Text="Region"/>
                    <set:SettingsSegmented DockPanel.Dock="Right" VerticalAlignment="Center"
                                           ItemsSource="{Binding RegionOptions}" SelectedValue="{Binding Region}"/>
                  </DockPanel>
                </StackPanel>
              </StackPanel>

              <StackPanel Visibility="{Binding ShowManualSection, Converter={StaticResource BoolVis}}">
                <Rectangle Style="{StaticResource Separator}"/>
                <DockPanel Style="{StaticResource Row}">
                  <TextBlock Style="{StaticResource RowLabel}" Text="Used"/>
                  <TextBox DockPanel.Dock="Right" Style="{StaticResource Field}" AutomationProperties.Name="Used"
                           Text="{Binding ManualUsed, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
                <Rectangle Style="{StaticResource Separator}"/>
                <DockPanel Style="{StaticResource Row}">
                  <TextBlock Style="{StaticResource RowLabel}" Text="Limit"/>
                  <TextBox DockPanel.Dock="Right" Style="{StaticResource Field}" AutomationProperties.Name="Limit"
                           Text="{Binding ManualLimit, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
                <Rectangle Style="{StaticResource Separator}"/>
                <DockPanel Style="{StaticResource Row}">
                  <TextBlock Style="{StaticResource RowLabel}" Text="Resets"/>
                  <TextBox DockPanel.Dock="Right" Style="{StaticResource Field}" AutomationProperties.Name="Resets"
                           Text="{Binding ManualResetText, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
              </StackPanel>

              <StackPanel Visibility="{Binding ShowCustomSection, Converter={StaticResource BoolVis}}">
                <Rectangle Style="{StaticResource Separator}"/>
                <Grid Style="{StaticResource WideRow}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Style="{StaticResource WideRowLabel}"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource RowLabel}" Text="Display name"/>
                  <TextBox Grid.Column="1" Style="{StaticResource WideField}" AutomationProperties.Name="Display name"
                           Text="{Binding CustomName, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
                <Rectangle Style="{StaticResource Separator}"/>
                <Grid Style="{StaticResource WideRow}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Style="{StaticResource WideRowLabel}"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource RowLabel}" Text="HTTPS endpoint"/>
                  <TextBox Grid.Column="1" Style="{StaticResource WideField}" AutomationProperties.Name="HTTPS endpoint"
                           Text="{Binding Endpoint, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
                <Rectangle Style="{StaticResource Separator}"/>
                <DockPanel Style="{StaticResource Row}">
                  <TextBlock Style="{StaticResource RowLabel}" Text="Method"/>
                  <set:SettingsSegmented DockPanel.Dock="Right" VerticalAlignment="Center"
                                         ItemsSource="{Binding MethodOptions}" SelectedValue="{Binding HttpMethod}"/>
                </DockPanel>
                <Rectangle Style="{StaticResource Separator}"/>
                <Grid Style="{StaticResource WideRow}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Style="{StaticResource WideRowLabel}"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource RowLabel}" Text="Dashboard URL"/>
                  <TextBox Grid.Column="1" Style="{StaticResource WideField}" AutomationProperties.Name="Dashboard URL"
                           Text="{Binding DashboardUrl, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
              </StackPanel>
            </StackPanel>
          </Border>
          <TextBlock Style="{StaticResource Footnote}" Text="{Binding ModeExplanation}"/>
          <TextBlock Style="{StaticResource Footnote}" Text="{Binding ConnectorWarning}" Foreground="{x:Static dgn:Palette.Warning}"
                     Visibility="{Binding ConnectorWarning, Converter={StaticResource NullVis}}"/>
          <TextBlock Style="{StaticResource Footnote}" Text="{Binding ManualLimitWarning}" Foreground="{x:Static dgn:Palette.Warning}"
                     Visibility="{Binding ManualLimitWarning, Converter={StaticResource NullVis}}"/>
          <TextBlock Style="{StaticResource Footnote}" Visibility="{Binding ShowManualSection, Converter={StaticResource BoolVis}}"
                     Text="The gauge shows used against limit. The reset date is a reminder only."/>
          <TextBlock Style="{StaticResource Footnote}" Visibility="{Binding ShowLocalSignInCopy, Converter={StaticResource BoolVis}}"
                     Text="AIUsageMeter reads an existing local sign-in and never refreshes, rotates, or rewrites it."/>
          <TextBlock Style="{StaticResource Footnote}" Visibility="{Binding ShowUnavailableCopy, Converter={StaticResource BoolVis}}"
                     Text="No safe built-in usage endpoint is available on Windows. Choose Custom JSON or Manual budget."/>

          <StackPanel Visibility="{Binding ShowCustomSection, Converter={StaticResource BoolVis}}">
            <TextBlock Style="{StaticResource Section}" Text="Response fields"/>
            <Border Style="{StaticResource Card}">
              <StackPanel Grid.IsSharedSizeScope="True">
                <Grid Style="{StaticResource WideRow}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Style="{StaticResource WideRowLabel}"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource RowLabel}" Text="Percent"/>
                  <TextBox Grid.Column="1" Style="{StaticResource WideField}" AutomationProperties.Name="Percent path"
                           Text="{Binding PercentPath, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
                <Rectangle Style="{StaticResource Separator}"/>
                <Grid Style="{StaticResource WideRow}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Style="{StaticResource WideRowLabel}"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource RowLabel}" Text="Used"/>
                  <TextBox Grid.Column="1" Style="{StaticResource WideField}" AutomationProperties.Name="Used path"
                           Text="{Binding UsedPath, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
                <Rectangle Style="{StaticResource Separator}"/>
                <Grid Style="{StaticResource WideRow}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Style="{StaticResource WideRowLabel}"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource RowLabel}" Text="Limit"/>
                  <TextBox Grid.Column="1" Style="{StaticResource WideField}" AutomationProperties.Name="Limit path"
                           Text="{Binding LimitPath, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
                <Rectangle Style="{StaticResource Separator}"/>
                <Grid Style="{StaticResource WideRow}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Style="{StaticResource WideRowLabel}"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource RowLabel}" Text="Resets"/>
                  <TextBox Grid.Column="1" Style="{StaticResource WideField}" AutomationProperties.Name="Resets path"
                           Text="{Binding ResetPath, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
              </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource Footnote}" Text="Dot-separated, with array indexes — for example data.0.usage.percent."/>
          </StackPanel>

          <!-- Where the secret is sent and what it is are one subject, so they are one card. Custom
               JSON keeps the card even with the placement set to None, or there would be no row
               left to set it back with. -->
          <StackPanel Visibility="{Binding ShowCredentialSection, Converter={StaticResource BoolVis}}">
            <TextBlock Style="{StaticResource Section}" Text="Credential"/>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <StackPanel Visibility="{Binding ShowCustomSection, Converter={StaticResource BoolVis}}">
                  <DockPanel Style="{StaticResource Row}">
                    <TextBlock Style="{StaticResource RowLabel}" Text="Send the secret as"/>
                    <set:SettingsPicker DockPanel.Dock="Right" VerticalAlignment="Center" Width="200"
                                        ItemsSource="{Binding SecretPlacementOptions}" SelectedValue="{Binding SecretPlacement}"/>
                  </DockPanel>
                  <StackPanel Visibility="{Binding ShowApiKeyHeader, Converter={StaticResource BoolVis}}">
                    <Rectangle Style="{StaticResource Separator}"/>
                    <DockPanel Style="{StaticResource Row}">
                      <TextBlock Style="{StaticResource RowLabel}" Text="Header name"/>
                      <TextBox DockPanel.Dock="Right" Style="{StaticResource Field}" AutomationProperties.Name="Header name"
                               Text="{Binding ApiKeyHeader, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>
                  </StackPanel>
                </StackPanel>

                <StackPanel Visibility="{Binding ShowSecretRow, Converter={StaticResource BoolVis}}">
                  <Rectangle Style="{StaticResource Separator}"
                             Visibility="{Binding ShowCustomSection, Converter={StaticResource BoolVis}}"/>
                  <DockPanel Style="{StaticResource Row}">
                    <TextBlock Style="{StaticResource RowLabel}" Text="{Binding LiveSecretPrompt}"/>
                    <PasswordBox x:Name="SecretBox" DockPanel.Dock="Right" Style="{StaticResource SecretField}"
                                 PasswordChanged="Secret_Changed" AutomationProperties.Name="{Binding LiveSecretPrompt}"/>
                  </DockPanel>
                  <Rectangle Style="{StaticResource Separator}"/>
                  <DockPanel Style="{StaticResource Row}">
                    <TextBlock Text="{Binding SecretStatus}" Style="{StaticResource Body}" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="Save" Click="SaveSecret_Click"
                            DockPanel.Dock="Right" IsEnabled="{Binding CanSaveSecret}"/>
                    <Button Style="{StaticResource QuietButton}" Content="Remove" Click="RemoveSecret_Click" DockPanel.Dock="Right"
                            Margin="0,0,8,0" Visibility="{Binding HasStoredSecret, Converter={StaticResource BoolVis}}"/>
                  </DockPanel>
                </StackPanel>
              </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource Footnote}" Text="The secret is written to Windows Credential Manager, never to the settings file."/>
          </StackPanel>
         </StackPanel>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
