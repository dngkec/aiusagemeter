<Window x:Class="AIUsageMeter.Windows.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AIUsageMeter" Width="382" SizeToContent="Height" MaxHeight="900"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        ResizeMode="NoResize" MouseLeave="Window_MouseLeave">
  <Border Background="{StaticResource PanelBrush}" CornerRadius="18,0,0,18" Padding="10"
          BorderBrush="#403F414A" BorderThickness="1">
    <Grid>
      <TextBlock Text="No providers enabled" Foreground="{StaticResource MutedBrush}" Margin="12"
                 Visibility="{Binding HasProviders, Converter={StaticResource BooleanToVisibility}, ConverterParameter=invert}" />
      <ScrollViewer MaxHeight="860" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding Providers}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="{StaticResource CardBrush}" CornerRadius="12" Margin="0,0,0,8" Padding="10"
                    MouseLeftButtonUp="Provider_Click" Cursor="Hand">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="54" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Width="44" Height="58">
                  <Ellipse Width="42" Height="42" Stroke="#55565F" StrokeThickness="4" />
                  <Ellipse Width="42" Height="42" Stroke="{Binding Color}" StrokeThickness="4"
                           StrokeDashArray="{Binding ProgressDashArray}" StrokeDashCap="Round">
                    <Ellipse.RenderTransform><RotateTransform Angle="-90" CenterX="21" CenterY="21" /></Ellipse.RenderTransform>
                  </Ellipse>
                  <TextBlock Text="{Binding Monogram}" Foreground="White" FontSize="12" FontWeight="SemiBold"
                             HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,16" />
                  <TextBlock Text="{Binding PercentText}" Foreground="{Binding Color}" FontSize="9" FontWeight="Bold"
                             HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                </Grid>
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                  <DockPanel>
                    <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" FontSize="14" />
                    <TextBlock Text="{Binding Source}" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="8,3,0,0" />
                  </DockPanel>
                  <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibility}}" Margin="0,8,0,0">
                    <ItemsControl ItemsSource="{Binding Windows}">
                      <ItemsControl.ItemTemplate><DataTemplate>
                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <StackPanel><TextBlock Text="{Binding Label}" Foreground="#E6E6E9" FontSize="12"/><TextBlock Text="{Binding Reset}" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel>
                          <TextBlock Grid.Column="1" Text="{Binding Caption}" Foreground="{Binding Color}" FontWeight="SemiBold" Margin="12,0,0,0"/>
                        </Grid>
                      </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding Message}" Foreground="#FFCC80" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0" />
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      </ScrollViewer>
    </Grid>
  </Border>
</Window>
