<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>AIUsageMeter</AssemblyName>
    <RootNamespace>AIUsageMeter.Windows</RootNamespace>
    <!-- Without this the exe carries no icon at all, and the shell, the taskbar and the tray each
         fall back to the generic executable image. -->
    <ApplicationIcon>..\..\Resources\icons\aiusagemeter.ico</ApplicationIcon>
    <Version>1.1.0</Version>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AIUsageMeter.Core\AIUsageMeter.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AIUsageMeter.Windows.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Static instances, not InterVariable.ttf: WPF cannot render variable fonts. -->
    <Resource Include="Assets\Fonts\Inter-Regular.ttf" />
    <Resource Include="Assets\Fonts\Inter-Medium.ttf" />
    <Resource Include="Assets\Fonts\Inter-SemiBold.ttf" />
    <Resource Include="Assets\Fonts\Inter-Bold.ttf" />
    <Resource Include="..\..\Resources\icons\aiusagemeter.png">
      <Link>Assets\AppIcon.png</Link>
    </Resource>
    <!-- Nine sizes from 16 to 256. The window and the tray read it from here rather than scraping
         one image off the exe, so each takes the size it actually wants. -->
    <Resource Include="..\..\Resources\icons\aiusagemeter.ico">
      <Link>Assets\AppIcon.ico</Link>
    </Resource>
  </ItemGroup>
</Project>
